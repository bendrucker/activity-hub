{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["worker-configuration.d.ts", ".wrangler/", "tmp/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "overrides": [
    {
      // Test helpers live in the describe block they serve, and awaiting a
      // seed per row costs nothing a test notices.
      "files": ["**/*.test.ts", "test/**"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // The import script's module scope is its main body, so every helper
      // parameter named for what it takes shadows something. The corpus
      // verifier is the same kind of program: a standalone CLI whose awaits
      // are local file reads and in-process DuckDB work, with no subrequest
      // budget and no batch call to collapse into.
      "files": ["scripts/**", "container/verify-corpus.ts"],
      "rules": { "no-await-in-loop": "off", "no-shadow": "off" }
    }
  ]
}
