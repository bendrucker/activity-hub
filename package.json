{
  "name": "activity-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "lint": "oxlint --report-unused-disable-directives && ast-grep scan",
    "import": "bun scripts/import.ts",
    "test": "vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@garmin/fitsdk": "^21.213.0",
    "@mapbox/polyline": "^1.2.1",
    "csv-parse": "^7.0.2",
    "tz-lookup": "^6.1.25",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/bun": "^1.4.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/tz-lookup": "^6.1.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.111.0"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
