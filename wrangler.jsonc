{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activity-hub-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Every Access policy on hub.bendrucker.me is bypassable while the
  // workers.dev hostname serves the same worker. The route itself is
  // Terraform-managed in this repo's terraform/ (see terraform/routes.tf).
  "workers_dev": false,
  // Pinned so CI only needs CLOUDFLARE_API_TOKEN. Not a secret.
  "account_id": "72bdc77341dc52a3cf4a94097f9ad96f",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // App and athlete identity are public identifiers, safe to commit. The
    // athlete ID gates the OAuth callback to my account.
    "STRAVA_CLIENT_ID": "12215",
    "STRAVA_ATHLETE_ID": "5723594",
    // The June 2027 migration moves the API to www.api-v3.strava.com with
    // header-only auth, so both bases are config rather than constants.
    "STRAVA_API_BASE": "https://www.strava.com/api/v3",
    "STRAVA_OAUTH_BASE": "https://www.strava.com/oauth",
    // Filled with the real subscription id after `scripts/strava-subscription.ts create`
    // runs. Empty rejects all events.
    "STRAVA_SUBSCRIPTION_ID": "364847",
    "WAHOO_OAUTH_BASE": "https://api.wahooligan.com/oauth",
    "WAHOO_API_BASE": "https://api.wahooligan.com",
    "WAHOO_USER_ID": "587205",
  },
  "triggers": {
    // 06:00 sweeps Strava. Strava drops a webhook event after three failed
    // deliveries, so the sweep bounds any loss to a day's delay.
    //
    // 08:00 rebuilds the lake. It is a separate trigger because a sweep only
    // enqueues: decoding drains through the queue afterwards, and a rebuild in
    // the same invocation would read the artifacts that sweep was about to
    // replace. Two hours is far more than a full backlog needs.
    //
    // :30 every hour enqueues stale transform work. See SWEEP_CRON for why
    // this one runs hourly while the others run daily.
    //
    // :15 every hour trickles ten activities through the Strava photo
    // backfill, clear of the sweep and the dailies. See PHOTO_CRON for why the
    // job is paced this slowly.
    "crons": ["0 6 * * *", "0 8 * * *", "30 * * * *", "15 * * * *"],
  },
  "kv_namespaces": [{ "binding": "TOKENS", "id": "bc72d180846d490395293eb92370f99b" }],
  "durable_objects": {
    "bindings": [
      { "name": "TOKEN_BROKER", "class_name": "TokenBroker" },
      { "name": "DECODE_CONTAINER", "class_name": "DecodeContainer" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TokenBroker"] },
    { "tag": "v2", "new_sqlite_classes": ["DecodeContainer"] },
  ],
  "containers": [
    {
      "class_name": "DecodeContainer",
      "image": "./container/Dockerfile",
      // The build context is the repository root: the container imports the
      // telemetry decoders from src/, which sits above container/.
      "image_build_context": ".",
      // Decoding is CPU-bound and single-threaded per activity, and the
      // container overlaps four at a time. 6 GiB holds those four row sets
      // with room for DuckDB's Parquet write.
      "instance_type": "standard-2",
      // Every batch lands on one instance, so a second would only ever sit
      // cold. Raising this is the lever if a backlog drains too slowly.
      "max_instances": 1,
    },
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "activity-hub-raw" },
    { "binding": "LAKE", "bucket_name": "activity-hub-lake" },
  ],
  // The website's write surface. A service binding carries no credential and
  // tells the callee nothing about who called, so holding this binding is the
  // authorization and Publish's three methods are the whole boundary.
  "services": [
    {
      "binding": "SITE",
      "service": "bendrucker-me",
      "entrypoint": "Publish",
    },
  ],
  "d1_databases": [
    {
      "binding": "REGISTRY",
      "database_name": "activity-hub-registry",
      "database_id": "c95d449b-7feb-459f-bc6a-cd1eb18c2345",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "activity-hub-ingest" },
      { "binding": "TRANSFORM_QUEUE", "queue": "activity-hub-transform" },
    ],
    "consumers": [
      {
        "queue": "activity-hub-ingest",
        // Rate-limit parking spends a retry, and a backlog large enough to
        // outlast the source's budget window can park the same message many
        // times before it ever gets a turn. Three retries sent that message
        // to the dead letter queue instead.
        "max_retries": 50,
        "dead_letter_queue": "activity-hub-ingest-dlq",
        // upsertSourceRecord is read-then-write with no cross-statement
        // transaction. A single consumer keeps concurrent events for the
        // same ride from double-minting.
        "max_concurrency": 1,
      },
      {
        "queue": "activity-hub-transform",
        // Transform work is per-activity and idempotent on
        // (activity_id, stage), so it carries none of the ingest queue's
        // shared-write hazard and takes the default concurrency.
        //
        // Retries are few on purpose. A decode that fails five times fails on
        // the bytes, and the derived row is where that gets seen and fixed.
        // Burning fifty deliveries first only delays the signal.
        "max_retries": 5,
        "dead_letter_queue": "activity-hub-transform-dlq",
        // A batch is one container round trip, so a large one amortizes the
        // call. Thirty activities is a few seconds of decoding, well inside
        // the consumer's wall clock.
        "max_batch_size": 30,
        "max_batch_timeout": 30,
      },
    ],
  },
}
